{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// The app is TypeScript only. With JavaScript allowed, the generated
		// worker-configuration.d.ts pulls the build output in through its
		// `mainModule` type and `npm run check` fails on it after a build.
		"allowJs": false,
		"checkJs": false
	},
	"include": ["src", "tests", "vite.config.ts", "playwright.config.ts", "worker-configuration.d.ts"]
}
