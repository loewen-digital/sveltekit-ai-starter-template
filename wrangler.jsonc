{
	"name": "sveltekit-starter",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "CONTENT",
			"bucket_name": "sveltekit-starter-content"
		}
	]
}
