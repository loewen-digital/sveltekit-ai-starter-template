{
	"name": "sveltekit-starter",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24"
	},
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "wrangler dev",
		"check": "svelte-kit sync && wrangler types && vp check && svelte-check --tsconfig ./tsconfig.json",
		"format": "vp check --fix",
		"test": "vp test run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"wrangler": "^4.135.0",
		"vite-plus": "1.0.0"
	},
	"dependencies": {
		"@loewen-digital/flatdb": "^0.2.1",
		"@loewen-digital/fullstack": "^0.2.0",
		"@webtides/element-js-ssr-renderer": "0.4.0",
		"@webtides/element-library": "0.2.0",
		"worker-mailer": "^1.2.1",
		"zod": "^3.25.76"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
