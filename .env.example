# Database
# SQLite is used locally. For Cloudflare D1, configure in wrangler.toml
# DATABASE_URL=local.db

# Auth
# No external auth provider needed — Lucia uses session cookies with local DB

# Email
# Password reset and email verification need a real provider in production.
# Without one the app refuses to start sending rather than dropping mail
# silently. In dev it falls back to the console provider, which logs the reset
# and verification links to the terminal so you can click them directly.
#
# Provider: "resend", "smtp" or "console". Leave unset to auto-detect (resend
# when RESEND_API_KEY is set, smtp when SMTP_HOST is set, otherwise console in
# dev). Setting both RESEND_API_KEY and SMTP_HOST is an error — pick one here.
# EMAIL_PROVIDER=resend
#
# Sender address, required by every real provider. The domain must be verified.
# EMAIL_FROM="Acme <noreply@acme.com>"

# --- Option A: Resend (HTTP API) -------------------------------------------
# Simplest to operate, and gives delivery/bounce webhooks.
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Option B: SMTP (any mail server) --------------------------------------
# Provider-independent: point this at a client's own mail infrastructure
# without touching code. No webhooks, and one SMTP handshake per message.
#
# NOTE: SMTP requires the Cloudflare Workers runtime and does NOT work under
# `vite dev` — use EMAIL_PROVIDER=console locally, or `wrangler pages dev`.
# Port 25 is blocked by Cloudflare; use 587 (STARTTLS) or 465 (implicit TLS).
# SMTP_HOST=smtp.acme.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@acme.com
# SMTP_PASSWORD=xxxxxxxx
#
# TLS mode. Defaults to implicit TLS on port 465 and STARTTLS everywhere else,
# so you normally do not need to set this.
# SMTP_SECURE=false

# Rate limiting
# Set to "true" to switch off the auth rate limiter. The E2E suite needs this
# because it drives every test from a single IP. Never enable in production.
# DISABLE_RATE_LIMIT=false
